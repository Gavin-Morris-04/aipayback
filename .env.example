# Copy this file to .env and fill it in. .env is git-ignored and must never be committed.
#
# IMPORTANT: never put ANTHROPIC_API_KEY here or in your shell. If that variable is set,
# Claude Code bills the API key instead of your Claude subscription. The app's key has
# its own name on purpose.

# Console API key for the app (create it with a workspace spend limit).
AIPAYBACK_API_KEY=

# Shared project Gmail. SEC requires a contact email in every request's User-Agent.
SEC_CONTACT_EMAIL=

# Optional
# AIPAYBACK_OFFLINE=false         # true = never call the API; cache misses raise
# AIPAYBACK_DEVICE=gavin-laptop   # label for this machine in the ledger
